{
  "version": 1,
  "author": "StrideSense Team",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-mpu6050", "id": "imu", "top": -120, "left": -10, "attrs": {} },
    { "type": "wokwi-potentiometer", "id": "fsr_l_heel", "top": 180, "left": -220, "attrs": { "label": "L-Heel (GPIO 36)" } },
    { "type": "wokwi-potentiometer", "id": "fsr_l_forefoot", "top": 180, "left": -90, "attrs": { "label": "L-Forefoot (GPIO 39)" } },
    { "type": "wokwi-potentiometer", "id": "fsr_r_heel", "top": 180, "left": 60, "attrs": { "label": "R-Heel (GPIO 34)" } },
    { "type": "wokwi-potentiometer", "id": "fsr_r_forefoot", "top": 180, "left": 190, "attrs": { "label": "R-Forefoot (GPIO 35)" } },
    { "type": "wokwi-pushbutton", "id": "btn_sos", "top": 80, "left": -180, "attrs": { "color": "red", "label": "SOS / Cancel" } },
    { "type": "wokwi-led", "id": "led_status", "top": -90, "left": 150, "attrs": { "color": "blue", "label": "Onboard LED (GPIO 2)" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "esp:3V3", "imu:VCC", "red", [ "v0" ] ],
    [ "esp:GND.1", "imu:GND", "black", [ "v0" ] ],
    [ "esp:21", "imu:SDA", "cyan", [ "v0" ] ],
    [ "esp:22", "imu:SCL", "yellow", [ "v0" ] ],

    [ "esp:3V3", "fsr_l_heel:VCC", "red", [ "v0" ] ],
    [ "esp:GND.1", "fsr_l_heel:GND", "black", [ "v0" ] ],
    [ "esp:36", "fsr_l_heel:SIG", "orange", [ "v0" ] ],

    [ "esp:3V3", "fsr_l_forefoot:VCC", "red", [ "v0" ] ],
    [ "esp:GND.1", "fsr_l_forefoot:GND", "black", [ "v0" ] ],
    [ "esp:39", "fsr_l_forefoot:SIG", "purple", [ "v0" ] ],

    [ "esp:3V3", "fsr_r_heel:VCC", "red", [ "v0" ] ],
    [ "esp:GND.1", "fsr_r_heel:GND", "black", [ "v0" ] ],
    [ "esp:34", "fsr_r_heel:SIG", "green", [ "v0" ] ],

    [ "esp:3V3", "fsr_r_forefoot:VCC", "red", [ "v0" ] ],
    [ "esp:GND.1", "fsr_r_forefoot:GND", "black", [ "v0" ] ],
    [ "esp:35", "fsr_r_forefoot:SIG", "blue", [ "v0" ] ],

    [ "esp:GND.1", "btn_sos:1.l", "black", [ "v0" ] ],
    [ "esp:14", "btn_sos:2.l", "blue", [ "v0" ] ],

    [ "esp:2", "led_status:A", "blue", [ "v0" ] ],
    [ "esp:GND.1", "led_status:C", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}
